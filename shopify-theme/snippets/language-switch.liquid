{%- comment -%} EN | FR switch. Shows only when the store has more than one language published. {%- endcomment -%}
{%- if localization.available_languages.size > 1 -%}
  {%- form 'localization', class: 'lang' -%}
    <span class="visually-hidden">{{ 'general.language' | t }}</span>
    {%- for language in localization.available_languages -%}
      <button type="submit" name="locale_code" value="{{ language.iso_code }}"
        aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}"
        lang="{{ language.iso_code }}" title="{{ language.endonym_name | capitalize }}">
        {{- language.iso_code | split: '-' | first | upcase -}}
      </button>
    {%- endfor -%}
  {%- endform -%}
{%- endif -%}
