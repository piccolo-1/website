<section class="password">
  <span class="logo-mark logo-mark--full password__logo" role="img" aria-label="{{ shop.name | escape }}"></span>
  <h1>{{ 'password.title' | t }}</h1>
  {%- assign default_message = 'password.text' | t -%}
  <p>{{ shop.password_message | default: default_message }}</p>
  {%- form 'storefront_password', class: 'news password__form' -%}
    <input type="password" name="password" placeholder="{{ 'password.label' | t }}" aria-label="{{ 'password.label' | t }}" required>
    <button type="submit" aria-label="{{ 'password.submit' | t }}">→</button>
    {%- if form.errors -%}<p class="news__error">{{ form.errors | default_errors }}</p>{%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
