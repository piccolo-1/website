<section class="listing">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="cookie-grid">
      {%- for article in blog.articles -%}
        <a class="cookie-card" href="{{ article.url }}">
          <div class="cookie-card__img">{%- render 'theme-image', image: article.image, fallback: 'salted-chunk-sm.webp', width: 800, alt: article.title -%}</div>
          <div class="cookie-card__body"><h3>{{ article.title }}</h3><p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p></div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
